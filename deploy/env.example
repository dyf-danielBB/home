# NAS 数据目录与容器运行用户
DLC_DATA_ROOT=/volume1/docker/dlc-space
DLC_PUID=1000
DLC_PGID=1000

# 对外服务端口。PAN_PORT 与 WEB_PORT 为第二阶段预检保留，第一阶段 Compose 不消费。
BLOG_PORT=3101
PAN_PORT=3102
NAV_PORT=3103
WEB_PORT=3104
NAV_AUTH_PORT=3105
NAV_AUTH_BIND_ADDRESS=127.0.0.1

# Homepage 天气位置，默认上海。
HOMEPAGE_VAR_LATITUDE=31.2304
HOMEPAGE_VAR_LONGITUDE=121.4737

# 对外域名。PAN_DOMAIN 与 WEB_DOMAIN 同样留待第二阶段。
BLOG_DOMAIN=blog.example.com
PAN_DOMAIN=pan.example.com
NAV_DOMAIN=nav.example.com
WEB_DOMAIN=www.example.com

# 导航认证凭证必须在复制出的 .env 中设置；这里只保留无效占位，不提交真实凭证或哈希。
# NAV_USERNAME=replace-with-your-username
# NAV_PASSWORD_HASH='replace-with-your-caddy-hash'
