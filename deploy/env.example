# NAS 数据目录与容器运行用户
DLC_DATA_ROOT=/volume1/docker/dlc-space
DLC_PUID=1000
DLC_PGID=1000

# 对外服务端口
BLOG_PORT=3101
PAN_PORT=3102
NAV_PORT=3103
WEB_PORT=3104
NAV_AUTH_PORT=3105

# 对外域名
BLOG_DOMAIN=blog.example.com
PAN_DOMAIN=pan.example.com
NAV_DOMAIN=nav.example.com
WEB_DOMAIN=www.example.com

# 导航认证密码哈希示例：请替换为自行生成的 bcrypt/argon2 哈希，不要提交真实密码或哈希。
# NAV_PASSWORD_HASH='$2b$12$replace-with-your-own-password-hash'
