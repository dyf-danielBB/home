# 复制为 .env，或在 NAS 的部署环境中覆盖以下变量。
# 原始 Homepage 端口只绑定在本机；外部访问应经过认证反向代理。
NAV_PORT=3103

# 认证网关默认只允许 NAS 本机访问；只有反向代理位于另一台主机或另一 Docker 网络时才改为 0.0.0.0。
NAV_AUTH_BIND_ADDRESS=127.0.0.1
NAV_AUTH_PORT=3105
# NAV_USERNAME=replace-with-your-username
# NAV_PASSWORD_HASH='replace-with-your-caddy-hash'

# 默认上海坐标；NAS 迁移时可替换为部署地点的坐标。
HOMEPAGE_VAR_LATITUDE=31.2304
HOMEPAGE_VAR_LONGITUDE=121.4737
