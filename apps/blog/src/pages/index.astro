---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

---

<Layout>
  <main class="[&_p]:text-muted-foreground">
    <h1>DLC 空间</h1>
    <p>记录技术实践、个人项目和自托管生活。这里保持安静、清晰，也留一点深海极光。</p>
    <h2>最新文章</h2>
    <div class="flex flex-col gap-2">
      {
        posts.map((post) => (
          <a
            class="hover:bg-muted -mx-3 flex flex-col rounded-md px-3 py-2 no-underline"
            href={`/blog/${post.id}/`}
          >
            <span>{post.data.title}</span>
            <span class="text-muted-foreground">{post.data.description}</span>
            <span class="text-muted-foreground mt-1 text-sm">
              {post.data.tags.map((tag) => `#${tag}`).join("  ")}
            </span>
          </a>
        ))
      }
    </div>
  </main>
</Layout>
